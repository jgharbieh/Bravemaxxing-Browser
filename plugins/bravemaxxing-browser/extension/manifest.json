{
  "manifest_version": 3,
  "name": "Bravemaxxing Tab Groups",
  "version": "0.2.0",
  "description": "Keeps each AI agent's tabs in its own tab group. Drag a tab into the group to hand it to the agent, drag it out to take it back. Talks only to the local Bravemaxxing relay.",
  "key": "",
  "minimum_chrome_version": "120",
  "permissions": [
    "tabs",
    "tabGroups",
    "debugger",
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "sw.js"
  }
}
